{
  // Hipnos AI — configuración de Cloudflare Workers (web + chat del asistente)
  "name": "hipnosai-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Proveedor de IA compatible con OpenAI. La clave va como SECRETO "AI_API_KEY" en Cloudflare, nunca aquí.
  "vars": {
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "openai/gpt-oss-120b"
  },
  // Límite por visitante: 10 mensajes por minuto.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
