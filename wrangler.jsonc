{
  // Hipnos AI — configuración de Cloudflare Workers (web + chat del asistente)
  "name": "hipnosai-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*", "/p/*"]
  },
  // CLAVES EN CASCADA (orden en src/index.js -> DEFAULT_CASCADE).
  // Se guardan como SECRETOS en Cloudflare, nunca aquí. Solo se usan las que existan:
  //   GROQ_API_KEY (o AI_API_KEY)  -> Groq: gpt-oss-120b, luego gpt-oss-20b y llama-3.1-8b
  //   CEREBRAS_API_KEY             -> Cerebras: gpt-oss-120b
  //   GITHUB_MODELS_TOKEN          -> GitHub Models: gpt-4.1-mini
  //   TELEGRAM_BOT_TOKEN           -> Bot de tiendas en Telegram (lo da @BotFather)
  // Límite por visitante: 10 mensajes por minuto.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Base de datos del bot de tiendas (multi-negocio). Esquema en migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hipnosai-tiendas",
      "database_id": "11c7e92c-e690-4be7-b6b5-89b2c2592be1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
